<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The app's privacy manifest, which App Store Connect reads from the bundle.

  No tracking and no tracking domains. One type of data is collected: the
  words a player flags from a card, sent to the game's own server at
  peachofaword.com. A flag is something the player chooses to write, so it's
  Other User Content; it carries nothing about the player and a random ID made
  for that flag alone, so it's not linked; and it's for fixing the words, App
  Functionality, never tracking. The App Store label says the same.

  The one required-reason API is UserDefaults, for found words, day outcomes,
  the streak and the flags waiting to send, read and written only by this app,
  which is reason CA92.1. See Apple's "Describing use of required reason API".
  Wired in through project.yml, since the .xcodeproj is generated.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
